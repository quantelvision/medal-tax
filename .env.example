# Analytics — replace with real IDs before deploying. Do not commit real values.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_CONTAINER_ID=
# Google Search Console verification (HTML tag method)
NEXT_PUBLIC_GSC_VERIFICATION=

# Pixabay API — used only by the one-off media sourcing scripts in scripts/
# (media-manifest.mjs, fetch-candidates.mjs, fetch-video.mjs, build-media.mjs).
# Not read at build or runtime by the app itself.
PIXABAY_API_KEY=

# Contact form (app/contact/actions.ts) — server-side only, never exposed to
# the client. See README.md's "Contact form" section for full setup steps.

# Required to send anything at all. From https://resend.com/api-keys.
RESEND_API_KEY=

# The "from" address for both contact-form emails. Must be either Resend's
# sandbox address (onboarding@resend.dev — only delivers to the Resend
# account's own verified email, fine for testing) or an address on a domain
# you have verified in Resend (required for real delivery to the business
# inbox and to visitors). Falls back to the sandbox address if unset.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Where the "new enquiry" notification is sent. Falls back to site.email
# (info@medaltax.com, from lib/data/site.ts) if unset.
CONTACT_NOTIFICATION_TO=

# Off by default. Set to the literal string "true" to also email the
# visitor a confirmation copy — only turn this on once CONTACT_FROM_EMAIL is
# on a domain verified in Resend; sending a confirmation to an arbitrary
# visitor address from the unverified sandbox address will fail silently
# (the notification to the business still sends either way).
CONTACT_SEND_CONFIRMATION=false
