# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# env — never commit real secrets
.env*.local

# misc
.DS_Store
*.pem
next-env.d.ts

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# typescript
*.tsbuildinfo

# verification screenshots captured during development — QA artifacts, not
# project content; 48MB+ across dozens of PNGs, not meant for version control
/docs/screenshots/

# Claude Code session-local state, not project content
/.claude/

# Original high-resolution source videos, kept for re-encoding later if ever
# needed — the web-ready re-encodes actually served live in public/videos/.
/original-media/
